  tanks:
  - id: wall_titan
    displayName: Wall Titan
    roleLine: "TANKER / H\u1ED6 TR\u1EE2"
    subtitle: 
    tags:
    - TANKER
    - "H\u1ED6 TR\u1EE2"
    listIcon: {fileID: 0}
    portrait: {fileID: 0}
    definition: {fileID: 11400000, guid: 6c45234ae1746fa47a2143507c619a1c, type: 2}
    viewPrefab: {fileID: 0}
    viewId: 0
    unlockStageId: 
    normalSkill:
      displayName: Earth Break
      icon: {fileID: 0}
      subtitle: 
      costLabel: "KH\xD4NG T\u1ED0N N\u0102NG L\u01AF\u1EE2NG"
      energyText: +10
      cooldownText: 0.6s
      description: "Wall Titan ng\u01B0ng t\u1EE5 ma thu\u1EADt \u0111\u1EA5t \u0111\u1EC3
        t\u1EA5n c\xF4ng k\u1EBB \u0111\u1ECBch. Khi m\u1EE5c ti\xEAu \u1EDF ph\u1EA1m
        vi xung quanh 3 m\xE9t s\u1EBD g\xE2y l\u01B0\u1EE3ng s\xE1t th\u01B0\u01A1ng
        cao nh\u1EA5t; l\u1EF1c n\xE0y gi\u1EA3m d\u1EA7n theo kho\u1EA3ng c\xE1ch
        bay, t\u1ED1i \u0111a 7 m\xE9t. M\u1ED7i khi c\xFA \u0111\xE1nh tr\xFAng
        m\u1EE5c ti\xEAu, xe t\u0103ng h\u1ED3i ph\u1EE5c\u2026"
    specialSkill:
      displayName: Earth Wall
      icon: {fileID: 0}
      subtitle: 
      costLabel: "T\u1ED0N N\u0102NG L\u01AF\u1EE2NG"
      energyText: 45
      cooldownText: 10s
      description: "Ti\xEAu hao n\u0103ng l\u01B0\u1EE3ng \u0111\u1EC3 d\u1EF1ng
        m\u1ED9t ch\u01B0\u1EDBng ng\u1EA1i v\u1EADt v\u1EEFng ch\u1EAFc. B\u1EE9c
        t\u01B0\u1EDDng ho\xE0n to\xE0n ng\u0103n c\u1EA3n \u0111\u01B0\u1EDDng di
        chuy\u1EC3n c\u1EE7a k\u1EBB \u0111\u1ECBch c\u0169ng nh\u01B0 ch\u1EB7n
        \u0111\u1EE9ng c\xE1c \u0111\xF2n t\u1EA5n c\xF4ng d\u1EA1ng \u0111\u1EA1n
        bay \u0111i qua v\u1ECB tr\xED c\u1EE7a n\xF3. Khi h\u1EBFt th\u1EDDi gian
        duy tr\xEC, hi\u1EC7u \u1EE9ng k\u1EBFt\u2026"
    option1:
    - displayName: Stone Fortress
      icon: {fileID: 0}
      subtitle: 
      costLabel: 
      energyText: 50
      cooldownText: 12s
      description: "Wall Titan gia c\u1ED1 l\u1EDBp gi\xE1p, gi\xFAp nh\u1EADn m\u1ED9t
        l\u1EDBp khi\xEAn, t\u0103ng ph\xF2ng th\u1EE7. \u0110\u1ED5i l\u1EA1i, tr\u1ECDng
        l\u01B0\u1EE3ng t\u0103ng th\xEAm khi\u1EBFn t\u1ED1c \u0111\u1ED9 di chuy\u1EC3n
        c\u1EE7a xe t\u0103ng b\u1ECB gi\u1EA3m trong th\u1EDDi gian hi\u1EC7u l\u1EF1c."
    - displayName: Guardian Wall
      icon: {fileID: 0}
      subtitle: 
      costLabel: 
      energyText: 50
      cooldownText: 10s
      description: "B\u1EA3o v\u1EC7 b\u1EA3n th\xE2n v\xE0 m\u1ED9t \u0111\u1ED3ng
        minh \u0111\u01B0\u1EE3c ch\u1ECDn b\u1EB1ng l\u1EDBp b\u1EA3o h\u1ED9 ma
        thu\u1EADt gi\xFAp nh\u1EADn m\u1ED9t l\u1EDBp khi\xEAn. Trong th\u1EDDi
        gian duy tr\xEC, Wall Titan s\u1EBD g\xE1nh ch\u1ECBu m\u1ED9t ph\u1EA7n
        s\xE1t th\u01B0\u01A1ng thay cho m\u1EE5c ti\xEAu \u0111\u01B0\u1EE3c b\u1EA3o
        v\u1EC7. L\u01B0\u1EE3ng s\xE1t th\u01B0\u01A1ng \u0111\u01B0\u1EE3c chuy\u1EC3n
        sang\u2026"
    - displayName: Earth Prison
      icon: {fileID: 0}
      subtitle: 
      costLabel: 
      energyText: 60
      cooldownText: 14s
      description: "D\u1EF1ng n\xEAn c\u1EA5u tr\xFAc giam gi\u1EEF kh\xE9p k\xEDn,
        nh\u1ED1t ho\xE0n to\xE0n k\u1EBB \u0111\u1ECBch trong m\u1ED9t v\xF9ng h\xECnh
        tr\xF2n. Sau m\u1ED9t kho\u1EA3ng th\u1EDDi gian tr\xEC ho\xE3n ng\u1EAFn,
        v\xE1ch \u0111\xE1 s\u1EE5p \u0111\u1ED5 \u0111\xE8 n\xE1t v\xE0 g\xE2y s\xE1t
        th\u01B0\u01A1ng di\u1EC7n r\u1ED9ng l\xEAn c\xE1c m\u1EE5c ti\xEAu b\xEAn
        trong."
    option2:
    - displayName: Immovable Titan
      icon: {fileID: 0}
      subtitle: 
      costLabel: 
      energyText: +40
      cooldownText: 10s
      description: "Bi\u1EBFn Wall Titan th\xE0nh m\u1ED9t kh\u1ED1i ki\xEAn c\u1ED1
        b\u1EA5t \u0111\u1ED9ng, ho\xE0n to\xE0n mi\u1EC5n nhi\u1EC5m v\u1EDBi m\u1ECDi
        hi\u1EC7u \u1EE9ng kh\u1ED1ng ch\u1EBF v\xE0 t\u0103ng Ph\xF2ng th\u1EE7
        trong th\u1EDDi gian hi\u1EC7u l\u1EF1c."
    - displayName: Earth Guardian
      icon: {fileID: 0}
      subtitle: 
      costLabel: 
      energyText: 50
      cooldownText: 10s
      description: "\u0110\xE1nh d\u1EA5u m\u1ED9t \u0111\u1ED3ng minh \u0111\u1ED3ng
        th\u1EDDi bao ph\u1EE7 m\u1EE5c ti\xEAu b\u1EB1ng l\u1EDBp b\u1EA3o v\u1EC7
        ma thu\u1EADt \u0111\u1EA5t gi\xFAp t\u0103ng Ph\xF2ng th\u1EE7 cho \u0111\u1ED3ng
        minh. M\u1ED9t ph\u1EA7n s\xE1t th\u01B0\u01A1ng m\xE0 \u0111\u1ED3ng minh
        nh\u1EADn ph\u1EA3i s\u1EBD chuy\u1EC3n sang cho Wall Titan g\xE1nh ch\u1ECBu
        khi \u0111\u1ED3ng minh c\xF3 l\u1EDBp b\u1EA3o v\u1EC7.\u2026"
    - displayName: Earthquake
      icon: {fileID: 0}
      subtitle: 
      costLabel: 
      energyText: 65
      cooldownText: 14s
      description: "T\u1EA1o ra c\u01A1n ch\u1EA5n \u0111\u1ED9ng \u0111\u1ECBa ch\u1EA5n
        tr\xEAn di\u1EC7n r\u1ED9ng, li\xEAn t\u1EE5c g\xE2y s\xE1t th\u01B0\u01A1ng
        \u0111\u1ECBnh k\u1EF3 v\xE0 l\xE0m gi\u1EA3m t\u1ED1c \u0111\u1ED9 di chuy\u1EC3n
        c\u1EE7a to\xE0n b\u1ED9 k\u1EBB \u0111\u1ECBch \u0111\u1EE9ng trong ph\u1EA1m
        vi t\xE1c \u0111\u1ED9ng."
